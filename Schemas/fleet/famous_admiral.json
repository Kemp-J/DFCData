{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://dfc/schemas/fleet/famous_admiral.json",
    "title": "DFC Famous Admiral Data",
    "description": "Data file for a Famous Admiral.",
    "type": "object",
    "required": [
        "Admiral",
        "AdmiralLevel",
        "Class",
        "Type",
        "AdmiralPoints",
        "ShipPoints",
        "Points",
        "Tonnage",
        "BaseSize",
        "Profile",
        "Weapons",
        "Load",
        "FleetAdmiralAbilities",
        "AdmiralAbilities",
        "Flavour"
    ],
    "additionalProperties": false,
    "properties": {
        "Admiral":                 { "type": "string" },
        "AdmiralLevel":            { "type": "integer" },
        "Class":                   { "type": "string" },
        "Type":                    { "type": "string" },
        "AdmiralPoints":           { "type": "integer" },
        "ShipPoints":              { "type": "integer" },
        "Points":                  { "type": "integer" },
        "Tonnage":                 { "$ref": "https://dfc/schemas/defs.json#/$defs/Tonnage" },
        "BaseSize":                { "type": "integer" },
        "Profile":                 { "$ref": "https://dfc/schemas/defs.json#/$defs/ShipProfile" },
        "Weapons":                 { "type": "array", "items": { "$ref": "https://dfc/schemas/defs.json#/$defs/Weapon" } },
        "Load":                    { "type": "array", "items": { "$ref": "https://dfc/schemas/defs.json#/$defs/LoadEntry" } },
        "Upgrades":                { "type": "array", "items": { "$ref": "https://dfc/schemas/defs.json#/$defs/UpgradeEntry" } },
        "Rules":                   { "type": "array", "items": { "$ref": "https://dfc/schemas/defs.json#/$defs/Rule" } },
        "FleetAdmiralAbilities":   { "description": "Number of fleet abilities this admiral may take.", "type": "integer" },
        "AdmiralAbilities":        { "type": "array", "items": { "$ref": "https://dfc/schemas/defs.json#/$defs/Ability" } },
        "UsableIn":                { "type": "array", "items": { "$ref": "https://dfc/schemas/defs.json#/$defs/UsableInEntry" } },
        "Flavour":                 { "type": "string" }
    }
}
